  backImage: {fileID: 1652179716}
  backgroundImages:
  - {fileID: -1670669414952162930, guid: b04402cc501149d4493f1d18fb4be4cc, type: 3}
  - {fileID: 4443714562347759535, guid: 5a9951c2ec66c414d976883408b11c29, type: 3}
  - {fileID: -5420694969011523690, guid: a271b5b0e18ecc84f829bb488c9e8a55, type: 3}
  - {fileID: -5420694969011523690, guid: a271b5b0e18ecc84f829bb488c9e8a55, type: 3}
  audioSource: {fileID: 0}
  TextMeshProUGUIs: {fileID: 1476620827}
  stringTextMeshProUGUIs:
  - "\u0412\u043E\u0434\u0430\u2026 \u0441\u043E\u043B\u044C\u2026 \u043F\u0435\u0441\u043E\u043A.
    \u042F \u0436\u0438\u0432. \u0421\u043D\u043E\u0432\u0430."
  - "\u0414\u0435\u0441\u044F\u0442\u044C \u043B\u0435\u0442 \u044F \u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F.
    \u0418 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043E\u043D\u0438 \u043C\u0435\u043D\u044F
    \u043D\u0430\u0448\u043B\u0438. \u041A\u043E\u0440\u0430\u0431\u043B\u044C\u2026
    \u0432\u0437\u0440\u044B\u0432\u2026 \u0438 \u0432\u043E\u0442 \u044F \u0437\u0434\u0435\u0441\u044C.
    \u0413\u0434\u0435 \u2014 \xAB\u0437\u0434\u0435\u0441\u044C\xBB?"
  - "\u0413\u043E\u0440\u043E\u0434. \u0417\u043D\u0430\u0447\u0438\u0442, \u0435\u0441\u0442\u044C
    \u043B\u044E\u0434\u0438. \u0410 \u0440\u0430\u0437 \u0435\u0441\u0442\u044C
    \u043B\u044E\u0434\u0438 \u2014 \u0435\u0441\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u044B."
  - "\u0413\u043E\u0440\u043E\u0434. \u0417\u043D\u0430\u0447\u0438\u0442, \u0435\u0441\u0442\u044C
    \u043B\u044E\u0434\u0438. \u0410 \u0440\u0430\u0437 \u0435\u0441\u0442\u044C
    \u043B\u044E\u0434\u0438 \u2014 \u0435\u0441\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u044B."
